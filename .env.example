# Copy to .env.local for local development. Set the same variable in the Vercel
# project (Settings -> Environment Variables) for preview and production.
#
# Nothing in this file is a secret by itself, but LEAD_WEBHOOK_URL is an
# unauthenticated write endpoint on the CRM: anyone holding it can create
# contacts. Keep it out of the repository and out of client-side code — it is
# read only in src/app/api/leads/route.ts, which runs on the server.

# Inbound webhook on the CRM that receives update-signup submissions.
# GoHighLevel: Automation -> Workflows -> new workflow -> Inbound Webhook
# trigger, then copy the URL it gives you.
#
# Must be https. If this is unset, the signup form returns a plain "not
# connected yet" error rather than pretending to have saved anything.
LEAD_WEBHOOK_URL=
